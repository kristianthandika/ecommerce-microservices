{
  "name": "ecommerce-microservices",
  "version": "1.0.0",
  "private": true,
  "description": "E-Commerce Microservices reference and training kit - Inixindo Bandung",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=packages/logger --workspace=packages/resilient-http-client --workspace=packages/storage",
    "dev:all": "concurrently -n auth,product,order,gateway -c blue,green,magenta,cyan \"npm run dev --workspace=services/auth-service\" \"npm run dev --workspace=services/product-service\" \"npm run dev --workspace=services/order-service\" \"npm run dev --workspace=services/gateway\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "loadtest": "npm run loadtest --workspace=services/gateway",
    "test:e2e": "node scripts/e2e.mjs",
    "test:shopping": "node scripts/e2e-shopping.mjs",
    "openapi": "node scripts/openapi.mjs",
    "openapi:check": "node scripts/openapi.mjs --check && npm run openapi:lint",
    "openapi:lint": "redocly lint services/gateway/openapi.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@redocly/cli": "2.78.0",
    "@types/node": "^24.19.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
