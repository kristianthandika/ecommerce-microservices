# ============================================================================
# Contoh environment variable untuk seluruh sistem.
# Salin jadi `.env` (`cp .env.example .env`) — `.env` di-gitignore.
# Nilai default di sini aman untuk pengembangan lokal (Hari 1-3, sebelum
# Docker Compose). Docker Compose (m4.4) meng-override URL antar-service
# jadi hostname internal Docker.
# ============================================================================

# --- Logging (dipakai semua service, lihat packages/logger) ---
LOG_LEVEL=info

# --- Port listen tiap service (default sesuai konvensi) ---
AUTH_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
GATEWAY_PORT=8080

# --- URL antar-service (dibaca service LAIN; JANGAN hardcode di kode) ---
AUTH_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
GATEWAY_URL=http://localhost:8080

# --- Frontend (di-bake saat build Vite, BUKAN runtime) ---
VITE_API_BASE_URL=http://localhost:8080
