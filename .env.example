# Generate a private .env with: node scripts/setup.mjs
# Add --demo-admin to explicitly create a training admin with a random password.
LOG_LEVEL=info
AUTH_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
JWT_ISSUER=auth-service
VITE_API_BASE_URL=/api/v1
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Required: generate at least 32 random characters. Never commit real values.
INTERNAL_SERVICE_TOKEN=
# Alternatively use mounted secret files (preferred over values in production):
# INTERNAL_SERVICE_TOKEN_FILE=/run/secrets/service_token
# SEED_ADMIN_PASSWORD_FILE=/run/secrets/admin_password
# Optional TLS overlay: see docs/HARDENING.md.
# Session and retention tuning (defaults shown):
# JWT_EXPIRES_IN_SECONDS=900          # access token lifetime, 60-3600
# REFRESH_TTL_HOURS=168               # refresh token sliding lifetime
# REFRESH_FAMILY_MAX_HOURS=720        # absolute session lifetime
# REFRESH_COOKIE_PATH=/api/v1/auth    # path as seen by the browser
# REFRESH_COOKIE_SECURE=true          # keep true outside localhost
# REFRESH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# IDEMPOTENCY_RETENTION_HOURS=24      # how long settled order keys are remembered
# Per-customer stock hold limit, OWASP API6 (defaults shown):
# ORDER_MAX_OPEN_ORDERS=5             # open (not completed) orders per customer
# ORDER_MAX_UNITS_PER_PRODUCT=10      # units of one product across open orders
# API versioning, OWASP API9 (gateway; defaults shown):
# PUBLIC_API_PREFIX=/api              # prefix in front of the gateway, used in Link headers
# LEGACY_API_ENABLED=true             # serve unversioned /api/... as deprecated aliases
# LEGACY_API_SUNSET=2027-05-14T00:00:00Z
# Email verification, OWASP API6 (auth-service; defaults shown):
# EMAIL_VERIFICATION_REQUIRED=true    # new accounts must confirm their address before ordering
# MAIL_TRANSPORT=outbox               # outbox = readable by admins, TRAINING ONLY; webhook = real mail
# MAIL_ALLOW_INSECURE_OUTBOX=true     # explicit opt-in for local training; MUST be false for real delivery
# MAIL_WEBHOOK_URL=                   # receives POST {to, subject, text} when MAIL_TRANSPORT=webhook
# MAIL_WEBHOOK_TOKEN=                 # bearer token, at least 32 characters in production (or MAIL_WEBHOOK_TOKEN_FILE)
# FRONTEND_ORIGIN=http://localhost:3000   # base of the links inside mails
# Access-token revocation (order-service and product-service):
# REVOCATION_MAX_AGE_MS=5000          # cached revocations; expired cache + auth outage returns 503
